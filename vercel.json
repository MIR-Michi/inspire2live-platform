{
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "crons": [
    {
      "path": "/api/comms/digest",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/comms/conferences",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/comms/newsfeed",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/comms/podcast/radar",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/comms/podcast/retention",
      "schedule": "45 3 * * 0"
    }
  ]
}
